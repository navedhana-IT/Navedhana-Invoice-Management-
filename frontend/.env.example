# NestJS origin used by the /api/* and /socket.io/* rewrites and by server-side (SEO) fetches.
API_URL=http://localhost:4000
# Public site URL for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Navedhana Ledger
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional public API origin for realtime over WebSockets (e.g. https://api.example.com).
# Empty = Socket.IO long-polling through the same-origin /socket.io rewrite.
NEXT_PUBLIC_WS_URL=

# Must match REVALIDATE_SECRET in backend/.env; guards POST /api/revalidate.
REVALIDATE_SECRET=
