# Copy to backend/.env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://navedhana:change-me@localhost:5432/navedhana
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# Any S3-compatible store (AWS S3, RustFS, MinIO, R2). Leave S3_ENDPOINT empty for AWS.
# The bucket is created on boot if it does not exist.
S3_ENDPOINT=http://localhost:9000
# Optional: host used in signed URLs when browsers can't reach S3_ENDPOINT (Docker: http://localhost:9000).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=navedhana
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=5242880

# PDF rendering. Docker images ship Chromium; locally point at an installed Chrome, e.g.
# CHROMIUM_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
CHROMIUM_PATH=

# Email (invitations, password resets, invoices). Empty = emails are logged instead of sent.
# Local inbox: docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit, then SMTP_URL=smtp://localhost:1025
SMTP_URL=
MAIL_FROM=Navedhana Ledger <no-reply@navedhana.local>
INVITE_TTL_HOURS=168
RESET_TTL_MINUTES=60

# Lets plan edits refresh the cached pricing page. Must match REVALIDATE_SECRET in frontend/.env.
REVALIDATE_SECRET=
WEB_INTERNAL_URL=http://localhost:3000

# Swagger UI at /api/docs (always on outside production).
ENABLE_DOCS=false

# Seed (prisma/seed.ts). The master admin is created only if it does not exist.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
SEED_DEMO=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Separate database used by backend e2e tests (it is reset on every run).
TEST_DATABASE_URL=
