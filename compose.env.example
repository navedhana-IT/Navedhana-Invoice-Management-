# Copy to compose.env and fill in. Generate secrets with: openssl rand -base64 48
NV_DB_PASSWORD=
NV_JWT_SECRET=
NV_S3_ACCESS_KEY=
NV_S3_SECRET_KEY=
NV_WEB_URL=http://localhost:3000
NV_S3_PUBLIC_URL=http://localhost:9000

# Email. Empty SMTP URL = the bundled Mailpit inbox (http://localhost:8025).
NV_SMTP_URL=
NV_SMTP_HOST=
NV_SMTP_PORT=465
NV_SMTP_SECURE=true
NV_SMTP_USER=
NV_SMTP_PASS=
NV_SMTP_FROM=
NV_MAIL_FROM=nbills <no-reply@navedhana.local>

# Shared secret that lets the API refresh cached marketing pages (pricing) after plan edits.
NV_REVALIDATE_SECRET=

# Optional public API origin for WebSocket realtime (e.g. https://api.example.com). Empty = long-polling via the web origin.
NV_WS_URL=

# Used by: docker compose --env-file compose.env run --rm api npx prisma db seed
NV_MASTER_ADMIN_EMAIL=
NV_MASTER_ADMIN_PASSWORD=
